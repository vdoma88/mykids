# Подключение к базе. Для локальной разработки достаточно поднять Postgres
# и создать две базы: рабочую и тестовую.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/mykids"
DATABASE_URL_TEST="postgresql://postgres@127.0.0.1:5433/mykids_test"

PORT=3000

# Журнал сервера: fatal, error, warn, info, debug. По умолчанию warn —
# ошибки видны, а строки на каждый запрос агента нет.
LOG_LEVEL=warn

# Сессии родителя — случайные токены, в базе хранится только их хеш,
# поэтому секрета для подписи серверу не нужно.
