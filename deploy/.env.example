# Настройки домашнего сервера MyKids.
#
#   cp deploy/.env.example deploy/.env
#
# Значения ниже — примеры, и оставлять их нельзя. Это не формальность:
# пароль от этого сервера — это пароль от журнала активности вашего ребёнка
# и от его экранного времени.
#
# Сгенерировать оба значения:
#   openssl rand -base64 24

# Пароль пользователя базы. Наружу порт базы не публикуется, к ней ходит
# только сервер, но пароль всё равно должен быть свой.
POSTGRES_PASSWORD=смените-меня

# Необязательное.
# POSTGRES_USER=mykids
# POSTGRES_DB=mykids
# Порт, на котором семья открывает MyKids.
# API_PORT=3000
