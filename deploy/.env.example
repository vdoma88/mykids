# Настройки домашнего сервера MyKids.
#
#   cp deploy/.env.example deploy/.env
#
# Файл необязателен: база живёт во внутренней сети Docker, куда ходит только
# сервер, и пароль ей не нужен.
#
# Нужен он установкам до 0.9.1 — они заводили базу с паролем отсюда, и
# пароль хранится в самой базе. Если такая установка у вас есть, оставьте
# свой deploy/.env с прежним паролем как есть.

# POSTGRES_PASSWORD=прежний-пароль

# Необязательное.
# POSTGRES_USER=mykids
# POSTGRES_DB=mykids
# Порт, на котором семья открывает MyKids.
# API_PORT=3000
